{
  "name": "ankillousj",
  "version": "0.0.1",
  "description": "Java bytecode to WebAssembly compiler",
  "license": "GPL-3.0-or-later WITH Classpath-exception-2.0",
  "type": "module",
  "bin": {
    "ankillousj": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "audit": "tsc && node --experimental-strip-types test/audit.ts",
    "test": "tsc && node --experimental-strip-types test/run.ts",
    "diff": "tsc && node --experimental-strip-types test/differential.ts",
    "check": "npm run audit && npm test && npm run diff"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}